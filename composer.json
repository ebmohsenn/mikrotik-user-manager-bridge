{
    "name": "mohsenebrahimizadeh-ai/mikrotik-user-manager-bridge",
    "description": "WordPress plugin that bridges MikroTik RouterOS User Manager with WordPress and WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/mohsenebrahimizadeh-ai/mikrotik-user-manager-bridge",
    "support": {
        "issues": "https://github.com/mohsenebrahimizadeh-ai/mikrotik-user-manager-bridge/issues",
        "source": "https://github.com/mohsenebrahimizadeh-ai/mikrotik-user-manager-bridge"
    },
    "authors": [
        {
            "name": "Mohsen Ebrahimizadeh"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "sentry/sentry": "Optional error reporting; define MUMB_SENTRY_DSN in wp-config.php to enable."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "brain/monkey": "^2.6",
        "php-stubs/wordpress-stubs": "^6.8",
        "squizlabs/php_codesniffer": "^3.9",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MWP\\Tests\\": "tests/phpunit/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs",
        "cbf": "phpcbf",
        "lint": "find . -path ./vendor -prune -o -path ./admin/node_modules -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
