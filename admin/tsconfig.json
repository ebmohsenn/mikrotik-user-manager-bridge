{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@mwp/shared/*": ["src/common/*"],
      "@mwp/utils/*": ["src/utils/*"],
      "@mwp/api/*": ["src/api/*"],
      "@mwp/types": ["src/types"]
    }
  },
  "include": ["src", "setupTests.ts"]
}
