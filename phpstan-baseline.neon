parameters:
	ignoreErrors:
		-
			message: "#^Parameter \\#1 \\$text of function esc_attr expects string, int\\<1, max\\> given\\.$#"
			count: 1
			path: admin/class-profile-admin.php

		-
			message: "#^Parameter \\#1 \\$text of function esc_attr expects string, int given\\.$#"
			count: 3
			path: admin/class-server-admin.php

		-
			message: "#^Offset 1 on array\\{string, ''\\|numeric\\-string, numeric\\-string, non\\-falsy\\-string&numeric\\-string, non\\-falsy\\-string&numeric\\-string\\} in isset\\(\\) always exists and is not nullable\\.$#"
			count: 1
			path: includes/class-mikrotik-health.php

		-
			message: "#^Right side of && is always true\\.$#"
			count: 1
			path: includes/class-mikrotik-health.php

		-
			message: "#^Variable \\$seen in empty\\(\\) always exists and is not falsy\\.$#"
			count: 1
			path: includes/class-mikrotik-health.php

		-
			message: "#^Comparison operation \"\\>\" between 60 and 0 is always true\\.$#"
			count: 1
			path: includes/class-rest.php

		-
			message: "#^Else branch is unreachable because ternary operator condition is always true\\.$#"
			count: 1
			path: includes/class-rest.php

		-
			message: "#^Strict comparison using \\=\\=\\= between null and mixed will always evaluate to false\\.$#"
			count: 12
			path: includes/class-server-registry.php

		-
			message: "#^Offset 'username' on array\\{id\\: mixed, username\\: mixed, password\\: '\\*\\*\\*', profile\\: mixed, service\\: mixed, local_address\\: mixed, remote_address\\: mixed, caller_id\\: mixed, \\.\\.\\.\\} on left side of \\?\\? always exists and is not nullable\\.$#"
			count: 2
			path: includes/rest/class-rest-users.php
