/admin/jest.config.cjs export-ignore
/admin/playwright.config.ts export-ignore
/admin/setupTests.ts export-ignore
/admin/stylelint.config.cjs export-ignore
/admin/tsconfig.json export-ignore
/admin/vite.config.js export-ignore
/admin/vite.health.config.js export-ignore
/composer.json export-ignore
/composer.lock export-ignore
